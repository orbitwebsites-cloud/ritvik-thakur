# --- x402 bot paywall (see README) ---
# Kill switch: set to "false" to disable the paywall entirely.
X402_ENABLED=true
# Wallet that receives USDC payments.
X402_PAY_TO=0x0ba3b8796ce61ef8Cbd11A7F33Be31F1Fd4A03B3
# Price per request charged to AI crawlers / scrapers.
X402_PRICE=$0.001
# CAIP-2 network. eip155:8453 = Base mainnet (USDC). eip155:84532 = Base Sepolia (testnet).
X402_NETWORK=eip155:8453
# Coinbase CDP facilitator (required for Base mainnet). If both are set, the CDP facilitator is used.
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=
# Fallback facilitator when CDP keys are not set (x402.org supports testnets only).
X402_FACILITATOR_URL=https://x402.org/facilitator
